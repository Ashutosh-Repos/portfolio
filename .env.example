# ==============================================================================
# ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Public URL of your deployed website (REQUIRED FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Why this is needed:
# The LinkPreview component generates 100% dynamic live screenshots using the
# Microlink cloud screenshot service (https://microlink.io).
#
# External cloud screenshot services can only access publicly reachable URLs on
# the internet — they CANNOT access http://localhost:3000 during local development.
#
# When previewing internal routes (such as "/about"), LinkPreview prepends this
# base URL.
#
# In Local Development:
# - Internal route previews fall back to the live public deployment URL.
# - If a newly created route (like /about) has not been deployed yet, the preview
#   will show 404 until it is deployed to production.
#
# In Production (e.g. Vercel / Netlify / Cloudflare):
# - Set this environment variable in your dashboard (e.g., Vercel Project Settings > Environment Variables):
#     NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
#   or your custom domain:
#     NEXT_PUBLIC_SITE_URL=https://ashutoshkumar.dev
# - Once deployed, all internal route previews will dynamically capture your live,
#   rendered pages.
NEXT_PUBLIC_SITE_URL=https://portfolio-3-0-blond.vercel.app
